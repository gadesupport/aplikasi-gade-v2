# Salin file ini menjadi .env, isi nilainya, lalu restart dev server.
# Nilai diambil dari dashboard Supabase → Project Settings → API Data.

# VITE_SUPABASE_URL — Project URL, contoh: https://xxxxxxxx.supabase.co
# VITE_SUPABASE_ANON_KEY — anon/public key. Aman untuk frontend karena
#   akses data tetap dibatasi oleh Row Level Security (RLS) di database.
#
# JANGAN PERNAH mengisi service_role key / secret di file ini.
# Semua variabel berawalan VITE_ ikut terkirim ke browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
